df["Area (m²)"] = pd.to_numeric(df["Area (m²)"], errors="coerce")

mask = (df["Price"] > 0) & (df["Area (m²)"] > 0)
df["price_per_sqm"] = np.where(mask, df["Price"] / df["Area (m²)"], np.nan)
df["log_price"] = np.where(df["Price"] > 0, np.log(df["Price"]), np.nan)
df["price_per_sqm"] = df["price_per_sqm"].round(4)
df["log_price"] = df["log_price"].round(4)

df["District_encoded"] = df["Address"].astype("category").cat.codes

for col in ["Price", "Area (m²)", "price_per_sqm"]:
    col_min, col_max = df[col].min(), df[col].max()
    if col_max > col_min:
        df[col + "_norm"] = ((df[col] - col_min) / (col_max - col_min)).round(4)
    else:
        df[col + "_norm"] = np.nan

for col in ["Price", "Area (m²)", "price_per_sqm"]:
    mean, std = df[col].mean(), df[col].std()
    if std > 0:
        df[col + "_std"] = ((df[col] - mean) / std).round(2)
    else:
        df[col + "_std"] = np.nan

df["Date"] = pd.to_datetime(df["Date"], format="%d.%m.%Y", errors="coerce")
df = df.sort_values("Date")
df["year"] = df["Date"].dt.year
df["month"] = df["Date"].dt.month
df["price_lag_1"] = df["Price"].shift(1)
df["price_roll_5"] = df["Price"].rolling(window=5, min_periods=1).mean().round(2)

