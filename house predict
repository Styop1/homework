INPUT_CSV = "original_data.csv"
OUTPUT_CSV = "cleaned_data.csv"
PLAUSIBLE_BOUNDS = (8, 500)

df = pd.read_csv(INPUT_CSV)

canon = lambda s: re.sub(r'[^a-z0-9]+', '', str(s).strip().lower())
c2o = {}
for col in df.columns:
    c2o.setdefault(canon(col), col)

def find_col(cands):
    for c in cands:
        if c in c2o:
            return c2o[c]
    for want in cands:
        for have, orig in c2o.items():
            if want in have:
                return orig
    return None

price_col = find_col(["price"]) or (_ for _ in ()).throw(ValueError("Price column not found"))
source_col = find_col(["source"]) or (_ for _ in ()).throw(ValueError("Source column not found"))
area_col = find_col(["area","aream2","aream"]) or (_ for _ in ()).throw(ValueError("Area column not found"))
addr_col = find_col(["address"]) or (_ for _ in ()).throw(ValueError("Address column not found"))

price_raw = df[price_col].astype("string")
bad_mask = (
    price_raw.str.lower()
    .str.replace(r"\s+","",regex=True)
    .str.contains("request|month", na=False)
)

def only_digits(x):
    if pd.isna(x):
        return np.nan
    d = re.sub(r"[^0-9]", "", str(x))
    return int(d) if d else np.nan

df["_Price_clean"] = pd.to_numeric(price_raw.mask(bad_mask, np.nan).apply(only_digits), errors="coerce")

def mode_or_median(s: pd.Series):
    s = pd.to_numeric(s, errors="coerce").dropna()
    if s.empty:
        return np.nan
    m = s.mode(dropna=True)
    return float(m.iloc[0]) if not m.empty else float(s.median())

per_source = df.groupby(source_col)["_Price_clean"].apply(mode_or_median).to_dict()
global_fill = mode_or_median(df["_Price_clean"])

def fill_price(row):
    v = row["_Price_clean"]
    if pd.isna(v):
        cand = per_source.get(row[source_col], np.nan)
        v = cand if not pd.isna(cand) else global_fill
    return (np.nan if pd.isna(v) else int(round(v)))

df[price_col] = pd.to_numeric(df.apply(fill_price, axis=1), errors="coerce").astype("Int64")

ABSOLUTE_MAX = 1_000_000
df = df[(df[price_col].isna()) | (df[price_col] <= ABSOLUTE_MAX)].copy()

def clean_area_str(s: pd.Series):
    s = s.astype(str)
    s = s.str.replace(r"(?i)q\.?\s*m\.?", "", regex=True)
    s = s.str.replace(r"[mM]²", "", regex=True)
    s = s.str.replace(r"[^0-9,.\-]", "", regex=True).str.replace(",", ".", regex=False)
    return s

area_num = pd.to_numeric(clean_area_str(df[area_col]), errors="coerce")
area_num[(~np.isfinite(area_num)) | (area_num <= 0)] = np.nan

lo, hi = PLAUSIBLE_BOUNDS
area_num[(area_num < lo) | (area_num > hi)] = np.nan

area_median = area_num.median()
area_num = area_num.fillna(area_median)

q1, q3 = area_num.quantile(0.25), area_num.quantile(0.75)
iqr = q3 - q1
if iqr > 0:
    area_num = area_num.clip(q1 - 1.5*iqr, q3 + 1.5*iqr)

df[area_col] = area_num.round().astype("Int64")

pattern1 = re.compile(r",\s*([^,]+?)\s*,\s*Yerevan", re.IGNORECASE)
pattern2 = re.compile(r"^\s*([^,]+?)\s*,\s*[^,]*\b(St|Street)\b", re.IGNORECASE)

def extract_district(addr):
    if not isinstance(addr, str) or not addr.strip():
        return np.nan
    addr = addr.strip()
    m1 = pattern1.search(addr)
    if m1:
        return m1.group(1).strip()
    m2 = pattern2.search(addr)
    if m2:
        return m2.group(1).strip()
    parts = [p.strip() for p in addr.split(",") if p.strip()]
    if len(parts) >= 3:
        return parts[-2]
    if len(parts) == 2:
        return parts[0] if not re.search(r"\b(St|Street)\b", parts[0], re.I) else parts[1]
    return addr

df[addr_col] = df[addr_col].apply(extract_district)
df.drop(columns=[c for c in ["_Price_clean","_Price_filled"] if c in df.columns], inplace=True, errors="ignore")
df.to_csv(OUTPUT_CSV, index=False)

df = pd.read_csv("cleaned_data.csv")

df["Price"] = (
