df = pd.read_csv("final_cleaned_data.csv")
df = df.dropna(subset=["Price", "Area (m²)", "price_per_sqm", "District_encoded"])

df["Price"] = pd.to_numeric(df["Price"], errors="coerce")
df["Area (m²)"] = pd.to_numeric(df["Area (m²)"], errors="coerce")
df["price_per_sqm"] = pd.to_numeric(df["price_per_sqm"], errors="coerce")
df["District_encoded"] = pd.to_numeric(df["District_encoded"], errors="coerce")

df = df.dropna(subset=["Price", "Area (m²)", "price_per_sqm", "District_encoded"])

if "Area (m²)_norm" in df.columns and "price_per_sqm_norm" in df.columns:
    feature_cols = ["Area (m²)_norm", "price_per_sqm_norm", "District_encoded"]
else:
    feature_cols = ["Area (m²)", "price_per_sqm", "District_encoded"]

X = df[feature_cols].to_numpy(dtype=float)
y = df["Price"].to_numpy(dtype=float).reshape(-1, 1)

n_samples, n_features = X.shape

X_b = np.hstack([np.ones((n_samples, 1)), X])

split_idx = int(0.8 * n_samples)
X_train, X_test = X_b[:split_idx], X_b[split_idx:]
y_train, y_test = y[:split_idx], y[split_idx:]

def predict(X, w):
    return X @ w

def mse(X, y, w):
    y_pred = predict(X, w)
    return float(np.mean((y_pred - y) ** 2))

def gradient(X, y, w):
    n = X.shape[0]
    y_pred = predict(X, w)
    return (2.0 / n) * (X.T @ (y_pred - y))

def gradient_descent(X, y, lr=0.05, n_iters=2000):
    n_features = X.shape[1]
    w = np.zeros((n_features, 1))
    history = []
    for i in range(n_iters):
        grad = gradient(X, y, w)
        w -= lr * grad
        if i % 50 == 0 or i == n_iters - 1:
            cost = mse(X, y, w)
            history.append(cost)
    return w, history

learn_rate = 0.05
n_iterations = 1500

w_opt, loss_history = gradient_descent(X_train, y_train, lr=learn_rate, n_iters=n_iterations)

def evaluate(X, y, w):
    y_pred = predict(X, w)
    mse_val = float(np.mean((y_pred - y) ** 2))
    mae_val = float(np.mean(np.abs(y_pred - y)))
    ss_tot = float(np.sum((y - y.mean()) ** 2))
    ss_res = float(np.sum((y - y_pred) ** 2))
    r2 = float(1 - ss_res / ss_tot) if ss_tot != 0 else np.nan
    return mse_val, mae_val, r2, y_pred

mse_test, mae_test, r2_test, y_pred_test = evaluate(X_test, y_test, w_opt)

n_show = min(10, X_test.shape[0])
for i in range(n_show):
