interface Iworkable
{
    void work();
    void go_home();
}

public class Person
{
    public string name { get; set; }
    public int age { get; set; }
}

public class Employee : Person, Iworkable
{
    public void work()
    {
        Console.WriteLine("working...");
    }public void go_home()
    {
        Console.WriteLine("going home...");
    }

}public class Employee1 : Person, Iworkable
{
    public void work()
    {
        Console.WriteLine("working emp1...");
    }public void go_home()
    {
        Console.WriteLine("going home emp1...");
    }

}


